# ZCU indexer configuration.
# Copy to .env and fill in. Never commit the real .env.

# Postgres (POSTGRES_PASSWORD is required; generate a long random one)
POSTGRES_USER=zcu
POSTGRES_DB=zcu_index
POSTGRES_PASSWORD=

# Bearer token the explorer must send. Required. Generate with:
#   openssl rand -hex 32
API_TOKEN=

# ZCU node
ZCU_RPC_URL=https://node-zcu.honest.money

# Indexer tuning
BATCH_SIZE=50
POLL_MS=5000
BALANCE_INTERVAL_MS=60000
REORG_DEPTH=12
